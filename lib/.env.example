# LINE Messaging API
# Get these from https://developers.line.biz → your channel → Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# Airtable
# Token: https://airtable.com/account → API → Create personal access token
# Base ID: found in the API docs URL for your base (starts with "app")
AIRTABLE_API_TOKEN=your_airtable_api_token_here
AIRTABLE_BASE_ID=your_base_id_here

# Optional — defaults to 客戶紀錄 if not set
TABLE_NAME=客戶紀錄
