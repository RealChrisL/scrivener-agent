# ServiceFlow-Agent — environment variables
# Copy this file to your SERVICEFLOW_DATA_DIR as ".env" and fill in all values.
# Default data directory: ~/.claude/channels/line
# Never commit .env to version control.

# ── LINE Messaging API ────────────────────────────────────────────────────────
# Obtain from: https://developers.line.biz → your channel → Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# ── Airtable ──────────────────────────────────────────────────────────────────
# Token: https://airtable.com/account → API → Create personal access token
# Base ID: visible in your base's API docs URL (starts with "app")
AIRTABLE_API_TOKEN=your_airtable_api_token_here
AIRTABLE_BASE_ID=your_base_id_here

# Table name in your Airtable base (default: client_records)
TABLE_NAME=client_records
